{
  "name": "@profullstack/r3q",
  "version": "0.2.0",
  "description": "A REST client for your terminal. Requests are files you can commit; the TUI is just a good way to look at them.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/profullstack/r3q",
  "bin": {
    "r3q": "./bin/r3q.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1",
    "node": ">=22.6"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "build": "bun x tsc -p tsconfig.json",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "test": "bun test test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@profullstack/hqtui": "^0.6.2"
  },
  "optionalDependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "amqplib": "^0.10.4",
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "rest",
    "http",
    "client",
    "tui",
    "terminal",
    "hqtui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/r3q.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
